{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run start)",
      "Bash(npm test*)",
      "Bash(npm run lint)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(ls*)",
      "Bash(pwd)",
      "Read(**/*.tsx)",
      "Read(**/*.ts)",
      "Read(**/*.jsx)",
      "Read(**/*.js)",
      "Read(**/*.css)",
      "Read(**/*.json)",
      "Read(**/*.md)",
      "Read(**/*.mjs)",
      "Read(**/*.mts)",
      "Edit(**/*.tsx)",
      "Edit(**/*.ts)",
      "Edit(**/*.jsx)",
      "Edit(**/*.js)",
      "Edit(**/*.css)",
      "Edit(**/*.json)",
      "Edit(**/*.md)",
      "Write(**/*.tsx)",
      "Write(**/*.ts)",
      "Write(**/*.jsx)",
      "Write(**/*.js)",
      "Write(**/*.css)",
      "Write(**/*.json)",
      "Write(**/*.md)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git reset*)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(npx*)",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.envrc)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)"
    ]
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude Sonnet 4.5 <noreply@anthropic.com>",
    "pr": "🤖 Generated with Claude Code"
  }
}
